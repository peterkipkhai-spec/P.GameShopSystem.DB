<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game Shop</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
    <header class="border-b border-slate-800">
        <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
            <a asp-controller="Home" asp-action="Index" class="font-bold text-indigo-300">Game Shop</a>
            <div class="space-x-4 text-sm">
                <a asp-controller="Home" asp-action="Index" class="text-slate-300 hover:text-white">Catalog</a>
                <a asp-controller="Auth" asp-action="Login" class="text-slate-300 hover:text-white">Login</a>
                <a asp-controller="Auth" asp-action="Register" class="text-slate-300 hover:text-white">Register</a>
            </div>
        </nav>
    </header>

    <main class="max-w-5xl mx-auto py-10 px-4">
        @RenderBody()
    </main>
</body>
</html>
