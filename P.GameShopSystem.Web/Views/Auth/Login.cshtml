@model P.GameShopSystem.Web.Models.Auth.LoginViewModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-6 shadow-xl">
    <h1 class="text-2xl font-semibold mb-6">Sign in</h1>
    @if (TempData["AuthMessage"] is string message)
    {
        <p class="mb-4 rounded-md bg-emerald-500/20 border border-emerald-500/30 px-3 py-2 text-sm">@message</p>
    }
    <form method="post" class="space-y-4">
        <input asp-for="PhoneNumber" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2" placeholder="Phone number" />
        <input asp-for="Password" type="password" class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2" placeholder="Password" />
        <span asp-validation-summary="ModelOnly" class="text-red-400 text-sm"></span>
        <button class="w-full rounded-lg bg-indigo-500 hover:bg-indigo-400 px-4 py-2 font-medium">Login</button>
    </form>
    <a asp-action="Register" class="block mt-4 text-sm text-indigo-300">Need an account? Register</a>
</div>
